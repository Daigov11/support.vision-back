# Copiar a "infra/.env" para desarrollo local. NINGÚN valor aquí es un secreto real:
# son credenciales de solo-desarrollo para una base de datos accesible únicamente en localhost.

POSTGRES_DB=visionsupport
POSTGRES_USER=visionsupport
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_PORT=5432

SERVER_HTTP_PORT=5080
WEB_PORT=5173

# Origen que el backend acepta por CORS para el panel web. Se deriva de WEB_PORT (arriba) para
# que ambos no puedan desincronizarse: si cambias WEB_PORT a 5178 (p. ej. porque el 5173 ya
# está en uso), esto se ajusta solo. Para un origen totalmente distinto (otro host/dominio,
# no solo otro puerto), reemplaza esta línea por un valor literal en vez de "${WEB_PORT}".
CORS_ALLOWED_ORIGIN=http://localhost:${WEB_PORT}

# --- Coturn (relay TURN) ---
# TURN_SHARED_SECRET: "changeme_dev_only_turn_secret" NO es apto para nada fuera de tu propia
# máquina. Genera uno real con `openssl rand -hex 32` antes de exponer Coturn a una red que no
# controles (incluida cualquier LAN compartida) o a un VPS.
TURN_SHARED_SECRET=changeme_dev_only_turn_secret
TURN_REALM=visionsupport.local
TURN_PORT=3478
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200

# TURN_PUBLIC_HOST: el host/IP que el backend pone en las URLs turn:/stun: que recibe el cliente.
# TURN_EXTERNAL_IP: la IP que el propio Coturn anuncia en sus respuestas de relay (necesaria
# porque, dentro de Docker, Coturn solo conoce su IP interna del contenedor).
# En la práctica, casi siempre son la MISMA IP:
#   - Desarrollo local con Android (emulador o dispositivo en tu LAN): la IP LAN de tu máquina
#     (`ipconfig getifaddr en0` en Mac, `hostname -I` en Linux), nunca 127.0.0.1/localhost —
#     el emulador/dispositivo no la resolverían a tu máquina.
#   - VPS: la IP pública del servidor (con los puertos de abajo abiertos en el firewall/security
#     group: 3478/udp+tcp y el rango de relay 49160-49200/udp).
TURN_PUBLIC_HOST=localhost
TURN_EXTERNAL_IP=

# --- Autenticación (JWT + primer Admin) ---
# JWT_SIGNING_KEY: "changeme_dev_only_..." NO es apto para nada fuera de tu propia máquina.
# Genera uno real con `openssl rand -base64 48` antes de exponer el backend fuera de localhost.
JWT_SIGNING_KEY=changeme_dev_only_jwt_signing_key_do_not_use_in_prod_32bytes_min
JWT_ISSUER=vision-support-dev
JWT_AUDIENCE=vision-support-clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# Bootstrap del primer Admin: SOLO se usa la primera vez que arranca el backend, si la tabla
# Users está vacía (no hay registro público). Deja estas dos líneas vacías/comentadas por
# defecto — nunca subas una contraseña real a git. Descoméntalas y define tus propios valores
# SOLO en tu infra/.env local para crear tu primer Admin (ver docs/local-development.md).
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=

# --- Diagnóstico de dispositivos ---
# Cuántos DeviceDiagnosticEvent como máximo se conservan por dispositivo (se podan los más
# antiguos al superar este número). Ver server/README.md, sección "Diagnóstico de dispositivos".
DIAGNOSTICS_MAX_EVENTS_PER_DEVICE=200
