# Plantilla de variables de entorno para producción (infra/docker-compose.prod.yml).
# Copia este archivo a infra/.env en el servidor (NUNCA lo subas al repositorio) y reemplaza
# todos los valores de ejemplo por secretos reales generados para ese despliegue.

# --- PostgreSQL (solo accesible dentro de la red de Docker, nunca publicado al host) ---
POSTGRES_DB=visionsupport
POSTGRES_USER=visionsupport
POSTGRES_PASSWORD=reemplaza_por_un_valor_aleatorio_largo

# --- CORS: debe ser EXACTAMENTE el origen del panel servido por Nginx ---
CORS_ALLOWED_ORIGIN=https://support.apiworking.com.pe

# --- JWT (autenticación de técnicos/admins) ---
JWT_SIGNING_KEY=reemplaza_por_un_valor_aleatorio_de_al_menos_32_bytes
JWT_ISSUER=vision-support
JWT_AUDIENCE=vision-support-clients
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=14

# --- Coturn / credenciales TURN efímeras ---
TURN_SHARED_SECRET=reemplaza_por_un_valor_aleatorio_largo
TURN_REALM=support.apiworking.com.pe
TURN_PUBLIC_HOST=api.support.apiworking.com.pe
TURN_PORT=3478
TURN_RELAY_MIN_PORT=49160
TURN_RELAY_MAX_PORT=49200
# IP pública real del VPS (la que anuncia Coturn en las respuestas de relay).
TURN_EXTERNAL_IP=203.0.113.10

# --- Bootstrap del primer Admin (solo se usa si la tabla Users está vacía) ---
INITIAL_ADMIN_EMAIL=admin@support.apiworking.com.pe
INITIAL_ADMIN_PASSWORD=reemplaza_por_una_contrasena_fuerte_temporal

# --- Backend ---
SERVER_HTTP_PORT=5080
DIAGNOSTICS_MAX_EVENTS_PER_DEVICE=200
